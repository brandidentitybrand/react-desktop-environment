{
  "name": "react-desktop-environment",
  "private": false,
  "version": "0.4.0",
  "description": "Desktop-style windowing for React: draggable, resizable windows, a start bar for minimised windows, and a nested window manager.",
  "keywords": [
    "react",
    "react-component",
    "desktop",
    "desktop-environment",
    "window",
    "window-manager",
    "draggable",
    "resizable",
    "taskbar"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brandidentitybrand/react-desktop-environment.git"
  },
  "homepage": "https://github.com/brandidentitybrand/react-desktop-environment#readme",
  "bugs": {
    "url": "https://github.com/brandidentitybrand/react-desktop-environment/issues"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": "./dist/main.js",
  "module": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "scripts": {
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "stylelint": "stylelint **/*.css",
    "stylelint:fix": "stylelint **/*.css --fix",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest --ui",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "vitest run && npm run build"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^1.5.0",
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/addon-interactions": "^8.4.7",
    "@storybook/addon-links": "^8.4.7",
    "@storybook/addon-onboarding": "^8.4.7",
    "@storybook/blocks": "^8.4.7",
    "@storybook/react": "^8.4.7",
    "@storybook/react-vite": "^8.4.7",
    "@storybook/test": "^8.4.7",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^20.14.8",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^1.6.0",
    "@vitest/ui": "^1.6.0",
    "autoprefixer": "^10.4.19",
    "clsx": "^2.1.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "eslint-plugin-storybook": "^0.8.0",
    "glob": "^10.4.2",
    "jsdom": "^24.1.0",
    "prettier": "^3.3.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "^8.4.7",
    "stylelint": "^16.6.1",
    "stylelint-config-standard": "^36.0.1",
    "terser": "^5.51.2",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "vite-plugin-dts": "^3.9.1",
    "vite-plugin-lib-inject-css": "^2.1.1",
    "vitest": "^1.6.0"
  }
}
